{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CyberHuntLab",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CWE-79",
              "name": "Cross-site Scripting",
              "shortDescription": {
                "text": "Entrada refletida sem codifica\u00e7\u00e3o (poss\u00edvel XSS refletido)"
              },
              "properties": {
                "security-severity": "6.1"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CWE-79",
          "level": "warning",
          "message": {
            "text": "Entrada refletida sem codifica\u00e7\u00e3o (poss\u00edvel XSS refletido) \u2014 O par\u00e2metro q de /search \u00e9 refletido na p\u00e1gina sem codifica\u00e7\u00e3o de sa\u00edda."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http://127.0.0.1:8081/search?q=PAYLOAD"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}